{
  "name": "elstracker",
  "version": "1.0.1",
  "main": "main.js",
  "private": true,
  "build": {
    "appId": "com.elstracker.app",
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "productName": "elstracker",
    "files": [
      "out/**/*",
      "main.js",
      "preload.js",
      "database.js",
      "tasks.js",
      "node_modules/**/*",
      "public/**/*"
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && copy preload.js out\\",
    "start": "electron-forge start",
    "lint": "eslint",
    "electron": "electron .",
    "app": "concurrently \"npm run dev\" \"npm run electron\"",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bootstrap": "^5.3.8",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "concurrently": "^9.2.3",
    "electron": "^42.5.0",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9"
  }
}
