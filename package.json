{
  "name": "elstracker",
  "version": "1.0.6",
  "main": "main.js",
  "private": true,
  "build": {
    "appId": "com.elstracker.app",
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "productName": "elstracker",
    "files": [
      "out/**/*",
      "main.js",
      "preload.js",
      "database.js",
      "tasks.js",
      "node_modules/**/*",
      "public/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "112112112112112",
      "repo": "elstracker",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && copy preload.js out\\",
    "start": "electron-forge start",
    "lint": "eslint",
    "electron": "electron .",
    "bot": "node bot.js",
    "app": "concurrently \"npm run dev\" \"npm run electron\" \"npm run bot\"",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "watch": "browser-sync start --proxy localhost:3000 --files 'pages/**/*.scss'",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.1",
    "bootstrap": "^5.3.8",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "nodemon": "^3.1.14",
    "sass": "^1.101.0"
  }
}
